        <mxCell id="4hOxsyU3DE6hKYaoCaZV-114" connectable="0" parent="4hOxsyU3DE6hKYaoCaZV-113" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#FF8000;" value="官窍感知外界，局部映射整体" vertex="1">
