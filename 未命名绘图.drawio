td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;时间、空间→引用；维度、初始条件→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L1 核合成&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈0%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;B03 中微子背景 ●&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;夸克、电子、光子、中微子、质子/中子、氢/氦/锂、物理常数、四种基本力&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;只提供原子核、物理常数&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L2 原子与辐射&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈0%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;B02 CMB ●&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;元素周期表、电磁波谱、黑体辐射、原子光谱&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;家具材料、灯光色温、屏幕光谱&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;电磁波谱、黑体辐射→引用；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L3 分子云&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈0%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;—&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;分子云、星际尘埃、星际磁场、宇宙线&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;不直接显现&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L4 恒星&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈0%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;B04 红外 ●、B05 紫外 ●、B06 宇宙线 ●&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;恒星、太阳、核聚变、超新星、重元素、红外、紫外、太阳风&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;太阳（已日落，不直接作用）；红外（电器散热）&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;太阳→标注；红外→引用；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L5 银河系&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈0%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;—&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;银河系、旋臂、银心、星团、星云、深空天体&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;窗外可能看到星空，但室内不直接影响&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L6 太阳系&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈1%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;B07 太阳风 ●、B09 太阳辐射压 ●&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;太阳、行星、月球、流星体、轨道力学&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;月球（窗外月光，若窗帘未拉）、轨道力学（决定晚上时间）&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;月球→引用；轨道力学→引用；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L7 地球&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈2%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;B08 地球磁场 ●、B10 地热流 ●、B11 放射性衰变 ●&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;地核、地幔、地壳、地球磁场、重力场、板块构造&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;重力场（家具重量、人体重量）、地壳（建筑地基）&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;重力场→引用；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L8 地质与大气&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈5%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部 │&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;大气、对流层、海洋、河流、山脉、土壤、水循环、云、雾、彩虹、闪电、露、霜、气温、湿度、气压、风速、降水、能见度&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;气温（室内空调/暖气）、湿度（加湿器/空调）、气压（极微弱）、风速（室内气流）、降水（窗外雨声）、能见度（窗外雾霾）&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;气温、湿度、降水（窗外雨声）→展开；气压、风速→引用；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L9 生命&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈10%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部 │&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;真菌、藻类、苔藓、蕨类、裸子植物、被子植物、无脊椎动物、鸟类、哺乳动物、昆虫、蜘蛛、蚯蚓、光合作用、呼吸作用、生物节律&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;宠物（狗/猫）、室内植物、昆虫（蚊子/苍蝇）、真菌（墙角霉菌）、呼吸作用（人/宠物）&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;宠物、室内植物、昆虫、真菌、呼吸作用→展开；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L10 生态&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈1%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部 │&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;食物链、物种相互作用、种群动态、栖息地、物质循环&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;宠物与室内植物的互动（猫吃草）、室内微生物&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;宠物互动→引用；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L11 意识&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈30%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部 │&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;视觉、听觉、触觉、嗅觉、味觉、前庭觉、本体感觉、温度感、痛觉、注意、记忆、情感、意图、学习&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;用户的视觉（看屏幕/书）、听觉（听音乐/电视）、触觉（家具触感）、嗅觉（室内气味）、味觉（晚餐）、温度感（空调）、注意（工作/娱乐）、记忆、情感、意图&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;视觉、听觉、触觉、嗅觉、味觉、温度感、注意、记忆、情感、意图→展开；前庭、本体、痛觉→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L12 社会&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈15%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部 │&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;语言、文字、音乐、艺术、教育、医疗、商业、法律、政治、宗教、节日、习俗、礼仪、道德、制度、经济、隐私规范、安全标准&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;语言（家人对话）、文字（屏幕文字）、音乐（播放）、教育（在线课程）、医疗（家庭药箱）、商业（网购）、隐私规范（家庭隐私）、安全标准（电器安全）&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;语言、文字、音乐、教育、医疗、商业、隐私、安全→展开；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L13 技术与城市&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈30%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部 │&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;工具、建筑、道路、桥梁、隧道、铁路、机场、港口、车辆、船舶、飞机、电力、通信、互联网、Wi-Fi、蜂窝网络、广播、电视、雷达、卫星、GPS、照明、广告牌、霓虹灯、空调、暖气、供水、排水、垃圾处理、能源&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;建筑（室内空间）、电力（照明/电器）、通信（手机/Wi-Fi）、互联网、电视、空调、暖气、供水、排水、垃圾处理、家具、家电&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;建筑、电力、通信、互联网、电视、空调、暖气、供水、排水、垃圾处理→展开；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;strong style=&quot;font-weight: 600;&quot;&gt;&lt;span class=&quot;&quot;&gt;L14 感知界面&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;≈7%&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;全部 │&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;视觉界面、听觉界面、触觉界面、嗅觉界面、味觉界面、前庭界面、本体感觉界面、跨模态整合、空间音频、空间锚定、场景融合、存在感、沉浸度&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;AR 在室内呈现（虚拟屏幕、虚拟宠物、虚拟装饰）、空间音频（室内声场）、触觉（手柄/触感衣）&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l2); font: var(--dsw-font-markdown-table); min-width: 100px; max-width: min(30vw, 320px); padding: 10px 0px 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;视觉、听觉、触觉、空间音频、空间锚定、场景融合→展开；其余→标注&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
