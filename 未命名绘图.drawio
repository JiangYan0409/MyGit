        <mxCell id="b1fRG6G1WEVx8HJ13RTH-699" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;align=center;labelBackgroundColor=none;resizable=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;rounded=1;arcSize=3;" value="&lt;table style=&quot;border-collapse: collapse; width: max-content; max-width: max-content; color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l3); font: var(--dsw-font-markdown-table-head); border-top: none; min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px 10px 0px;&quot;&gt;&lt;span class=&quot;&quot;&gt;层级&lt;/span&gt;&lt;/th&gt;&lt;th style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l3); font: var(--dsw-font-markdown-table-head); border-top: none; min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;影响权重&lt;/span&gt;&lt;/th&gt;&lt;th style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l3); font: var(--dsw-font-markdown-table-head); border-top: none; min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;&gt;&lt;span class=&quot;&quot;&gt;背景场&lt;/span&gt;&lt;/th&gt;&lt;th style=&quot;border-bottom: 1px solid var(--dsw-alias-border-l3); font: var(--dsw-font-markdown-table-head); border-top: none; min-width: 100px; max-width: min(30vw, 320px); padding: 10px 16px;&quot;