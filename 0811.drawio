          <mxGeometry height="100" width="560" x="10840" y="21214" as="geometry" />
        </mxCell>
        <mxCell id="GzwJVmzmDODFBmZMGdF7-56" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f0f8;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=10;" value="月（水之精）&#xa;属性：水气之精，方诸取水&#xa;影响机制：与五星生克，水克火、金生水&#xa;地球反应：水灾、民疫、盗贼&#xa;人类反应：祭月以羊彘，月食修刑" vertex="1">
