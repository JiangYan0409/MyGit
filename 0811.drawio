        <mxCell id="GzwJVmzmDODFBmZMGdF7-52" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e0;strokeColor=#dd9900;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#664400;align=left;spacingLeft=10;" value="日（阳之极）&#xa;属性：常满无亏，宣明于昼&#xa;影响机制：主光明、主施，统摄五星节律&#xa;地球反应：昼夜交替、四季更替&#xa;人类反应：人君之象、春分朝日" vertex="1">
          <mxGeometry height="100" width="560" x="9390" y="21214" as="geometry" />
        </mxCell>
        <mxCell id="GzwJVmzmDODFBmZMGdF7-53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f5;strokeColor=#888899;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#444455;align=left;spacingLeft=10;" value="月（阴之极）&#xa;属性：有阙有盈，纳明于夜&#xa;影响机制：主夜、主刑，统摄五星节律&#xa;地球反应：月相变化、潮汐消长&#xa;人类反应：妃后之象、秋分夕月" vertex="1">
          <mxGeometry height="100" width="560" x="10000" y="21214" as="geometry" />
        </mxCell>
