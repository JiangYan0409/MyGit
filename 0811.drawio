        <mxCell id="he2GaYkOudRTViyqP790-452" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;fontFamily=Microsoft YaHei;fontColor=#660000;strokeWidth=2;" value="总结" vertex="1">
