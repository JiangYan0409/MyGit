          <mxGeometry height="34" width="264.49541284403676" x="477.74963302752303" y="317" as="geometry" />
        </mxCell>
        <mxCell id="xsbeXi4ZopbAxWsLfnY3-535" parent="xsbeXi4ZopbAxWsLfnY3-503" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f8e8;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#224400;align=left;spacingLeft=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="1. 人法地，地法天，天法道，道法自然｜《老子》" vertex="1">
          <mxGeometry height="24" width="264.49541284403676" x="477.74963302752303" y="355" as="geometry" />
        </mxCell>
        <mxCell id="xsbeXi4ZopbAxWsLfnY3-536" parent="xsbeXi4ZopbAxWsLfnY3-503" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f8e8;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#224400;align=left;spacingLeft=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="2. 地生五谷，养万民｜《尚书》" vertex="1">
          <mxGeometry height="24" width="264.49541284403676" x="477.74963302752303" y="381" as="geometry" />
        </mxCell>
        <mxCell id="xsbeXi4ZopbAxWsLfnY3-537" parent="xsbeXi4ZopbAxWsLfnY3-503" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f8e8;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#224400;align=left;spacingLeft=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="3. 人立于地，承地之德｜《礼记》" vertex="1">
          <mxGeometry height="24" width="264.49541284403676" x="477.74963302752303" y="407" as="geometry" />
        </mxCell>
        <mxCell id="xsbeXi4ZopbAxWsLfnY3-538" parent="xsbeXi4ZopbAxWsLfnY3-503" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f8e8;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#224400;align=left;spacingLeft=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="4. 人有德则地出瑞，人无德则地生灾｜《尚书·洪范》" vertex="1">
          <mxGeometry height="24" width="264.49541284403676" x="477.74963302752303" y="433" as="geometry" />
        </mxCell>
        <mxCell id="xsbeXi4ZopbAxWsLfnY3-539" parent="xsbeXi4ZopbAxWsLfnY3-503" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f8e8;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#224400;align=left;spacingLeft=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="5. 地势坤，君子以厚德载物｜《周易·坤卦》象传" vertex="1">
          <mxGeometry height="24" width="264.49541284403676" x="477.74963302752303" y="459" as="geometry" />
        </mxCell>
        <mxCell id="xsbeXi4ZopbAxWsLfnY3-540" parent="xsbeXi4ZopbAxWsLfnY3-503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#444444;align=center;fontStyle=2;spacingLeft=10;spacingRight=10;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="▸ 地者，重浊之气凝聚而成。天施地受，地承天载物。地在五行中属土之盛，具坤德，厚德载物，静而能容。地是日月五星之气的承受者与显现者，是万物之形的所在，是人类立足与取养之基。" vertex="1">
          <mxGeometry height="50" width="853.211009174312" x="36.188990825688165" y="525" as="geometry" />
        </mxCell>
        <mxCell id="xsbeXi4ZopbAxWsLfnY3-546" parent="UmHISxPJmjEUVxG4FA49-11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;日月（阴阳之极）统摄五星节律&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;↓&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;五星各行其度：岁星十二岁周天，荧惑二年周天，镇星二十八岁周天，太白一岁周天，辰星一岁周天&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;↓&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;日月与五星互动：&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;├── 日月（火水）与五星按五行生克互相作用&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;├── 五星之间两两合、三星合、四星合、五星&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 30px; background-color: transparent;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;└── 五星入宿、守宿、犯宿&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;↓&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;天象呈现：正常或变异&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;↓&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b&gt;进入天地人循环&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="509.01" width="1371" x="4769" y="2298" as="geometry" />
        </mxCell>
        <mxCell id="UmHISxPJmjEUVxG4FA49-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#663333;align=center;spacingTop=8;dashed=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;「日月相推而明生焉。」——《周易·系辞》&lt;br&gt;&lt;br&gt;日与月，非二物也，乃一阴一阳、一刚一柔、一施一受、一明一夜之两端。日无月则不显其恒，月无日则不能有其光。月禀日光而成其体，日因月行而分其岁。二者相推、相感、相成，共构天地之节律与人伦之纲纪。故古人言「日月为易」，明其相须而不相离也。&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="146.42" width="380" x="5530" y="3612.29" as="geometry" />
        </mxCell>
