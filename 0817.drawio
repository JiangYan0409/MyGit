        <mxCell id="xsbeXi4ZopbAxWsLfnY3-544" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=50;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;【生成阶段】&lt;/div&gt;&lt;div&gt;混沌 → 元气 → 阴阳 → 五行 → 天（日月五星）→ 地（万物）→ 人&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="2700" x="2245" y="-550" as="geometry" />
        </mxCell>
        <mxCell id="xsbeXi4ZopbAxWsLfnY3-548" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;font-size: 50px;&quot;&gt;【运行阶段】&lt;/div&gt;&lt;div style=&quot;font-size: 50px;&quot;&gt;天施气于地 → 地受气而化 → 万物生长 → 人得养而生&lt;/div&gt;&lt;div style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;↑&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/div&gt;&lt;div style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 人观天察地&lt;/div&gt;&lt;div style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;│&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ↓&lt;/div&gt;&lt;div style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;└── 天复常 ← 人修省 ← 占验 ← 灾异显现&lt;/div&gt;&lt;/div&gt;" vertex="1">
