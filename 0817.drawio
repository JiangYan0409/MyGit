        <mxCell id="xsbeXi4ZopbAxWsLfnY3-532" parent="xsbeXi4ZopbAxWsLfnY3-503" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f8e8;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;fontColor=#224400;align=left;spacingLeft=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="5. 荧惑失次，地有火灾旱灾；辰星异常，地有水灾" vertex="1">
