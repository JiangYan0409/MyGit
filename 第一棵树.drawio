        <mxCell id="7L3AGora1TePQE9lAWJE-889" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;fontFamily=Microsoft YaHei;" value="太阳视半径（约0.27°）" vertex="1">
