        <mxCell id="7L3AGora1TePQE9lAWJE-1875" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#cc6600;align=left;spacingLeft=8;" value="在五运六气中的角色：每年不变的固定节律框架——是“常”，代表四季的正常气化顺序" vertex="1">
          <mxGeometry height="30" width="380" x="1011" y="5516" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1876" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑤ 客气（由年支推衍）" vertex="1">
          <mxGeometry height="28" width="380" x="1011" y="5557" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1877" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：三之气 = 司天，终之气 = 在泉，其余按三阴三阳顺序排列" vertex="1">
          <mxGeometry height="30" width="380" x="1011" y="5585" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1878" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：司天确定后 → 按厥阴→少阴→太阴→少阳→阳明→太阳顺序，每步前移一位" vertex="1">
          <mxGeometry height="30" width="380" x="1011" y="5612" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1879" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#cc6600;align=left;spacingLeft=8;" value="在五运六气中的角色：当年的“异常气化”叠加——是“变”，代表天体摄动导致的节律偏离" vertex="1">
          <mxGeometry height="30" width="380" x="1011" y="5642" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-2063" edge="1" parent="1" source="7L3AGora1TePQE9lAWJE-1880" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=0;" target="7L3AGora1TePQE9lAWJE-1937">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-2064" edge="1" parent="1" source="7L3AGora1TePQE9lAWJE-1880" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;curved=0;" target="7L3AGora1TePQE9lAWJE-2009">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1880" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontFamily=Microsoft YaHei;verticalAlign=top;opacity=60;" value="运气相合（五运 × 六气的耦合）" vertex="1">
          <mxGeometry height="300" width="860" x="1165" y="5796" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1881" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4e4;strokeColor=#b85450;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑥ 运与气的五行关系" vertex="1">
          <mxGeometry height="28" width="380" x="1195.5" y="5850" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1882" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：运（年干五行）与气（司天/客气五行）之间的生克关系" vertex="1">
          <mxGeometry height="20" width="380" x="1195.5" y="5882" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1883" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：运生（气）→ 顺化（平稳）；气克运 → 天刑（剧烈）；运克气 → 小逆（波动）；气生运 → 不和（异常）" vertex="1">
          <mxGeometry height="25" width="380" x="1195.5" y="5902" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1884" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#990000;align=left;spacingLeft=8;" value="在五运六气中的角色：决定气候的“平稳/剧烈”属性——是五运六气最核心的输出判断" vertex="1">
          <mxGeometry height="22" width="380" x="1195.5" y="5928" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1885" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4e4;strokeColor=#b85450;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑦ 运气同化（天符 / 岁会 / 同天符 / 同岁会）" vertex="1">
          <mxGeometry height="28" width="380" x="1195.5" y="5968" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1886" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：运与气的五行相同（如木运遇风木之气）时触发" vertex="1">
          <mxGeometry height="20" width="380" x="1195.5" y="6000" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1887" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：天符（司天+中运同化）、岁会（中运+年支同化）、同天符/同岁会（太过/不及的同化变体）" vertex="1">
          <mxGeometry height="27" width="380" x="1195.5" y="6018" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1888" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#990000;align=left;spacingLeft=8;" value="在五运六气中的角色：同化效应——该年某气特征被显著放大（太乙天符年气化极端，易发大疫）" vertex="1">
          <mxGeometry height="24" width="380" x="1195.5" y="6046" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1889" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4e4;strokeColor=#b85450;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑧ 客主加临（时相耦合）" vertex="1">
          <mxGeometry height="28" width="380" x="1619" y="5850" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1890" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：每步（约2个月）的客气叠加于主气之上，产生相位差" vertex="1">
          <mxGeometry height="20" width="380" x="1619" y="5882" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1891" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：客气每步前移一位（如司天为三之气，在泉为终之气），其余按顺序填入" vertex="1">
          <mxGeometry height="20" width="380" x="1619" y="5905" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1892" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#990000;align=left;spacingLeft=8;" value="在五运六气中的角色：决定具体每个时段（约2个月）的气候偏离方向——是五运六气的“高精度输出”" vertex="1">
          <mxGeometry height="32" width="380" x="1619" y="5927" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1893" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4e4;strokeColor=#b85450;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑨ 三年一“大疫”周期（气化异常积累）" vertex="1">
          <mxGeometry height="28" width="380" x="1619" y="5968" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1894" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：运气在“非其位”的状态（即气化偏差持续积累）达到阈值" vertex="1">
          <mxGeometry height="20" width="380" x="1619" y="6000" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1895" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：由运气相合 + 客主加临 + 运气同化的“极值状态”联合判定" vertex="1">
          <mxGeometry height="20" width="380" x="1619" y="6023" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1896" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#990000;align=left;spacingLeft=8;" value="在五运六气中的角色：某些年份（如太乙天符、天刑年）运气极端叠加，人体正气无法适应，引发大疫" vertex="1">
          <mxGeometry height="24" width="380" x="1619" y="6046" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1938" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;fontFamily=Microsoft YaHei;arcSize=3;verticalAlign=top;" value="大气环流（五运六气的物理载体）" vertex="1">
          <mxGeometry height="520" width="540" x="365" y="6311" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1939" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="① 大气温度（辐射强迫）" vertex="1">
          <mxGeometry height="28" width="500" x="383.5" y="6366" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1940" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：由太阳黄经和日地距离决定的理论辐射量，叠加大气温室效应" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6398" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1941" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：辐射传输模型（日射量 = 太阳常数 × 日地距离修正 × cos(天顶角)）" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6421" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1942" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=8;" value="在五运六气中的角色：热在气化中为君火/相火——温度偏高对应火气偏胜，偏低对应寒水偏胜" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6444" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1943" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="② 大气湿度（水汽循环）" vertex="1">
          <mxGeometry height="28" width="500" x="383.5" y="6484" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1944" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：由海洋蒸发、风带输送、降水决定，单位g/kg或相对湿度%" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6516" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1945" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：水汽通量计算（风速 × 比湿的垂直积分）；蒸发-降水平衡" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6539" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1946" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=8;" value="在五运六气中的角色：湿为太阴湿土——湿气偏重对应土运/湿土之气偏胜，是长夏和梅雨的主导因素" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6562" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1947" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="③ 大气压强（风带/气旋系统）" vertex="1">
          <mxGeometry height="28" width="500" x="383.5" y="6602" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1948" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：海平面气压（hPa），高空位势高度（gpm），副高/气旋/反气旋强度" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6634" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1949" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：气压梯度力 + 科里奥利力 → 地转风；温度梯度驱动经向环流" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6657" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1950" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=8;" value="在五运六气中的角色：风为厥阴风木——风带和气压系统的移动，是六气中气变化的直接动力来源" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6680" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1951" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="④ 海洋温度 / 洋流（热容与输送）" vertex="1">
          <mxGeometry height="28" width="500" x="383.5" y="6720" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1952" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：海表温度（SST），厄尔尼诺/拉尼娜指数（ONI），洋流输送量" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6752" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1953" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：海气耦合模型——海洋热含量变化滞后于大气强迫约1~3个月" vertex="1">
          <mxGeometry height="20" width="500" x="383.5" y="6775" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1954" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=8;" value="在五运六气中的角色：调制客气中的寒热偏差——海洋异常（如厄尔尼诺）是客气年度异常的大尺度物理实现，对应六气的“太过/不及”" vertex="1">
          <mxGeometry height="26" width="500" x="383.5" y="6798" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1955" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;fontFamily=Microsoft YaHei;arcSize=3;verticalAlign=top;" value="局部修正（大运 → 小气候）" vertex="1">
          <mxGeometry height="520" width="511.5" x="943.5" y="6311" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1956" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑤ 观测点纬度" vertex="1">
          <mxGeometry height="28" width="480" x="959.5" y="6360" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1957" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：北纬/南纬 0°~90°，决定太阳高度角、昼夜时长、季节相位" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6392" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1958" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：纬度越高 → 太阳高度角越低 → 辐射通量越分散 → 气温年较差越大" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6415" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1959" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：同一运气格局，赤道/温带/寒带表现完全不同——纬度决定气化的“基础温度+季节相位”" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6438" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1960" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑥ 观测点经度 / 时区" vertex="1">
          <mxGeometry height="28" width="480" x="959.5" y="6478" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1961" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：东经/西经 0°~180°，决定与UTC的固定偏移" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6510" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1962" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：每15°经度对应1小时时差，影响“当地正午”与“理论节气时刻”的相位差" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6533" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1963" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：同一时令，各地气化不同——经度决定“朔气时刻”与“本地时辰”的对齐或错位" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6556" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1964" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑦ 海拔高度" vertex="1">
          <mxGeometry height="28" width="480" x="959.5" y="6596" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1965" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：海平面以上高度（m），每升高1000m温度平均下降约6.5°C（干绝热/湿绝热递减率）" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6628" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1966" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：气压、温度、湿度随高度呈指数/线性变化；大气垂直分层（对流层/平流层）" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6651" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1967" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：海拔越高 → 气温越低、气压越低 → 寒象偏重，“高寒”或“低暖”的修正叠加在五运六气之上" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6674" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1968" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑧ 局部地形（山脉 / 盆地 / 水域）" vertex="1">
          <mxGeometry height="28" width="480" x="959.5" y="6714" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1969" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：地形分类（山地/平原/盆地/沿海/内陆），风带走廊或阻挡效应" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6746" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1970" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：地形抬升 → 降水增加；盆地 → 热岛/逆温；沿海 → 海洋性气候（温差小、湿度大）" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6769" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1971" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：形成“同气异化”——同一六气在不同地形下表现不同（如盆地暑湿更重，山地风多寒盛）" vertex="1">
          <mxGeometry height="20" width="480" x="959.5" y="6792" as="geometry" />
        </mxCell>
