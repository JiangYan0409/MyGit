        <mxCell id="7L3AGora1TePQE9lAWJE-1610" edge="1" parent="1" source="7L3AGora1TePQE9lAWJE-1573" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="7L3AGora1TePQE9lAWJE-1670">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1611" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;fontFamily=Microsoft YaHei;" value="太阳视半径（约0.27°）" vertex="1">
          <mxGeometry height="30" width="180" x="620" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1612" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳是圆盘而非光点，我们看到的是上边缘冒头而非中心，使日出提前约1~2分钟。" vertex="1">
          <mxGeometry height="25" width="180" x="620" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1613" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;fontFamily=Microsoft YaHei;" value="太阳引力场（广义相对论）" vertex="1">
          <mxGeometry height="30" width="180" x="620" y="1296" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1614" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳引力使光线弯曲（夏皮罗延迟），影响太阳边缘的观测位置（科研级精度才计入）" vertex="1">
          <mxGeometry height="25" width="180" x="620" y="1327" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1615" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="自转速率（15°/h）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1616" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="角度转换为时间的唯一系数，由恒星日长度（23h56m4s）决定。" vertex="1">
          <mxGeometry height="25" width="180" x="830" y="1251" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1617" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="黄赤交角（23.44°）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1287" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1618" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="设定太阳直射点的南北移动范围（±23.44°），是四季和赤纬变化的根本源头。" vertex="1">
          <mxGeometry height="38" width="180" x="830" y="1317.5" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1619" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球半径（6371 km）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1368" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1620" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="作为几何基准，用于计算海拔引起的“地平线俯角”。" vertex="1">
          <mxGeometry height="25" width="180" x="830" y="1399" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1621" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球椭球体形状（扁率）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1435" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1622" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="极地半径比赤道短约21km，高精度计算时需用WGS-84椭球模型修正观测者到地心的真实距离。" vertex="1">
          <mxGeometry height="40" width="180" x="830" y="1466" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1623" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点纬度（φ）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1522" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1624" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="决定地平线与天赤道的夹角，是时角计算的核心输入之一。" vertex="1">
          <mxGeometry height="25" width="180" x="830" y="1553" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1625" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点经度（λ₀）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1589" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1626" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="将地方时转换为标准区时的固定偏移。" vertex="1">
          <mxGeometry height="22" width="180" x="830" y="1620" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1627" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点海拔（h）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1656" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1628" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="海拔越高，地平线俯角越大，日出越早。" vertex="1">
          <mxGeometry height="22" width="180" x="830" y="1687" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1629" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="局部地形遮挡" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1723" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1630" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="东面有山/楼会延迟实际看到的日出，不参与天文公式，但影响真实观测。" vertex="1">
          <mxGeometry height="25" width="180" x="830" y="1754" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1631" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球自转不均匀（ΔT）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1632" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="由潮汐摩擦、地核运动等导致，使地球自转速度在世纪尺度上缓慢变化。" vertex="1">
          <mxGeometry height="25" width="180" x="830" y="1821" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1633" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="极移（钱德勒摆动）" vertex="1">
          <mxGeometry height="30" width="180" x="830" y="1857" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1634" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="自转轴相对于地壳微小移动（约±0.3角秒），改变观测点的真实经纬度。" vertex="1">
          <mxGeometry height="25" width="180" x="830" y="1889" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1635" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="稳定地轴倾角（23.44°）" vertex="1">
          <mxGeometry height="30" width="180" x="1040" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1636" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="使黄赤交角稳定在23.44°附近（波动±1°），保证赤纬长期可用。" vertex="1">
          <mxGeometry height="25" width="180" x="1040" y="1251" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1637" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="潮汐摩擦（地球自转变慢）" vertex="1">
          <mxGeometry height="30" width="180" x="1040" y="1287" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1638" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="月球引力拽拉海洋和固体地球，使地球自转每世纪减慢约1.8毫秒，累积为ΔT。" vertex="1">
          <mxGeometry height="25" width="180" x="1040" y="1318" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1639" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="章动（18.6年周期）" vertex="1">
          <mxGeometry height="30" width="180" x="1040" y="1354" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1640" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="使黄赤交角有约±9角秒的周期性摆动，影响赤纬的瞬时精密值。" vertex="1">
          <mxGeometry height="25" width="180" x="1040" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1641" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="岁差（与太阳合力）" vertex="1">
          <mxGeometry height="30" width="180" x="1040" y="1421" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1642" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="月球和太阳共同拖拽赤道隆起带，导致春分点西移（约50角秒/年），改变黄经的零度基准。" vertex="1">
          <mxGeometry height="34" width="180" x="1040" y="1453" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1643" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="木星引力摄动" vertex="1">
          <mxGeometry height="30" width="180" x="1250" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1644" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="木星质量巨大，使地球轨道偏心率在0.003~0.06之间缓慢波动（周期约10万年），改变椭圆修正项的大小。" vertex="1">
          <mxGeometry height="45" width="180" x="1250" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1645" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="金星引力摄动" vertex="1">
          <mxGeometry height="30" width="180" x="1250" y="1307" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1646" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="金星对地球轨道的摄动力仅次于木星，影响黄经长期积分中的近日点辐角变化。" vertex="1">
          <mxGeometry height="22" width="180" x="1250" y="1338" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1647" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="其他行星摄动（火土水）" vertex="1">
          <mxGeometry height="30" width="180" x="1250" y="1374" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1648" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="贡献较小，但在百万年尺度轨道积分中需累加计入。" vertex="1">
          <mxGeometry height="22" width="180" x="1250" y="1406" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1649" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气折射（蒙气差）" vertex="1">
          <mxGeometry height="30" width="180" x="1460" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1650" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="大气层使光线弯曲，将太阳的视位置“抬高”，让日出提前约2~4分钟。" vertex="1">
          <mxGeometry height="25" width="180" x="1460" y="1251" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1651" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气温度与气压" vertex="1">
          <mxGeometry height="30" width="180" x="1460" y="1287" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1652" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="折射率随气温和气压变化，影响蒙气差的精密值（亚秒级）。" vertex="1">
          <mxGeometry height="25" width="180" x="1460" y="1318" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1653" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气透明度（云/雾霾）" vertex="1">
          <mxGeometry height="30" width="180" x="1460" y="1354" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1654" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="不影响太阳几何位置，只决定是否能肉眼看到。" vertex="1">
          <mxGeometry height="25" width="180" x="1460" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1655" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" value="光行差（周年视差偏移）" vertex="1">
          <mxGeometry height="30" width="180" x="1670" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1656" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="地球以30km/s绕日运动，使太阳视位置偏移约20角秒，影响高精度方位角测量。" vertex="1">
          <mxGeometry height="25" width="180" x="1670" y="1251" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1657" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" value="引力光线弯曲（夏皮罗延迟）" vertex="1">
