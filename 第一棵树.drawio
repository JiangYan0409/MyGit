          <mxGeometry height="30" width="380" x="-9294.5" y="4437.5" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-466" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontColor=default;" value="② 岁运的太过与不及" vertex="1">
          <mxGeometry height="28" width="380" x="-9294.5" y="4487.5" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-467" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：阳干（甲丙戊庚壬）→ 太过，阴干（乙丁己辛癸）→ 不及" vertex="1">
          <mxGeometry height="30" width="380" x="-9294.5" y="4516.5" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-468" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：年干奇偶性决定——奇数（阳）为太过，偶数（阴）为不及" vertex="1">
          <mxGeometry height="30" width="380" x="-9294.5" y="4542.5" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-469" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#663399;align=left;spacingLeft=8;verticalAlign=middle;" value="在五运六气中的角色：太过之年气化偏“亢烈”，不及之年气化偏“虚弱”——决定气候极端程度" vertex="1">
          <mxGeometry height="30" width="380" x="-9294.5" y="4571.5" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-470" edge="1" parent="1" source="a6BHbfn1qw_weTyk3Nwu-471" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=0;" target="a6BHbfn1qw_weTyk3Nwu-484">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-471" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;fontFamily=Microsoft YaHei;arcSize=7;verticalAlign=top;" value="地支化气（太阳黄经 → 六气）" vertex="1">
          <mxGeometry height="440" width="420" x="-10039" y="4259" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-472" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="③ 年支 → 司天 / 在泉" vertex="1">
          <mxGeometry height="28" width="380" x="-10019" y="4314" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-473" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：年支为子、丑、寅、卯、辰、巳、午、未、申、酉、戌、亥" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4342" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-474" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：子午→少阴君火，丑未→太阴湿土，寅申→少阳相火，卯酉→阳明燥金，辰戌→太阳寒水，巳亥→厥阴风木" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4369" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-475" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#cc6600;align=left;spacingLeft=8;" value="在五运六气中的角色：司天（上半年）和在泉（下半年）的总气化倾向——统领全年的“客气”格局" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4399" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-476" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="④ 六气步位（主气）" vertex="1">
          <mxGeometry height="28" width="380" x="-10019" y="4441" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-477" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：以太阳黄经0°、30°、60°...为边界，每气约60.875天（四个节气）" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4469" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-478" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：初之气→厥阴风木，二之气→少阴君火，三之气→少阳相火，四之气→太阴湿土，五之气→阳明燥金，终之气→太阳寒水" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4496" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-479" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#cc6600;align=left;spacingLeft=8;" value="在五运六气中的角色：每年不变的固定节律框架——是“常”，代表四季的正常气化顺序" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4526" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-480" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑤ 客气（由年支推衍）" vertex="1">
          <mxGeometry height="28" width="380" x="-10019" y="4567" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-481" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：三之气 = 司天，终之气 = 在泉，其余按三阴三阳顺序排列" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4595" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-482" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：司天确定后 → 按厥阴→少阴→太阴→少阳→阳明→太阳顺序，每步前移一位" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4622" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-483" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#cc6600;align=left;spacingLeft=8;" value="在五运六气中的角色：当年的“异常气化”叠加——是“变”，代表天体摄动导致的节律偏离" vertex="1">
          <mxGeometry height="30" width="380" x="-10019" y="4652" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-484" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;fontFamily=Microsoft YaHei;verticalAlign=top;opacity=60;" value="运气相合（五运 × 六气的耦合）" vertex="1">
          <mxGeometry height="300" width="860" x="-9865" y="4806" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-485" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4e4;strokeColor=#b85450;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑥ 运与气的五行关系" vertex="1">
          <mxGeometry height="28" width="380" x="-9834.5" y="4860" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-486" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：运（年干五行）与气（司天/客气五行）之间的生克关系" vertex="1">
          <mxGeometry height="20" width="380" x="-9834.5" y="4892" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-487" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：运生（气）→ 顺化（平稳）；气克运 → 天刑（剧烈）；运克气 → 小逆（波动）；气生运 → 不和（异常）" vertex="1">
          <mxGeometry height="25" width="380" x="-9834.5" y="4912" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-488" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#990000;align=left;spacingLeft=8;" value="在五运六气中的角色：决定气候的“平稳/剧烈”属性——是五运六气最核心的输出判断" vertex="1">
          <mxGeometry height="22" width="380" x="-9834.5" y="4938" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-489" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4e4;strokeColor=#b85450;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑦ 运气同化（天符 / 岁会 / 同天符 / 同岁会）" vertex="1">
          <mxGeometry height="28" width="380" x="-9834.5" y="4978" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-490" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：运与气的五行相同（如木运遇风木之气）时触发" vertex="1">
          <mxGeometry height="20" width="380" x="-9834.5" y="5010" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-491" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：天符（司天+中运同化）、岁会（中运+年支同化）、同天符/同岁会（太过/不及的同化变体）" vertex="1">
          <mxGeometry height="27" width="380" x="-9834.5" y="5028" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-492" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#990000;align=left;spacingLeft=8;" value="在五运六气中的角色：同化效应——该年某气特征被显著放大（太乙天符年气化极端，易发大疫）" vertex="1">
          <mxGeometry height="24" width="380" x="-9834.5" y="5056" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-493" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4e4;strokeColor=#b85450;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑧ 客主加临（时相耦合）" vertex="1">
          <mxGeometry height="28" width="380" x="-9411" y="4860" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-494" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：每步（约2个月）的客气叠加于主气之上，产生相位差" vertex="1">
          <mxGeometry height="20" width="380" x="-9411" y="4892" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-495" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：客气每步前移一位（如司天为三之气，在泉为终之气），其余按顺序填入" vertex="1">
          <mxGeometry height="20" width="380" x="-9411" y="4915" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-496" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#990000;align=left;spacingLeft=8;" value="在五运六气中的角色：决定具体每个时段（约2个月）的气候偏离方向——是五运六气的“高精度输出”" vertex="1">
          <mxGeometry height="32" width="380" x="-9411" y="4937" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-497" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4e4;strokeColor=#b85450;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑨ 三年一“大疫”周期（气化异常积累）" vertex="1">
          <mxGeometry height="28" width="380" x="-9411" y="4978" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-498" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：运气在“非其位”的状态（即气化偏差持续积累）达到阈值" vertex="1">
          <mxGeometry height="20" width="380" x="-9411" y="5010" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-499" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：由运气相合 + 客主加临 + 运气同化的“极值状态”联合判定" vertex="1">
          <mxGeometry height="20" width="380" x="-9411" y="5033" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-500" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#990000;align=left;spacingLeft=8;" value="在五运六气中的角色：某些年份（如太乙天符、天刑年）运气极端叠加，人体正气无法适应，引发大疫" vertex="1">
          <mxGeometry height="24" width="380" x="-9411" y="5056" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-501" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;fontFamily=Microsoft YaHei;arcSize=3;verticalAlign=top;" value="大气环流（五运六气的物理载体）" vertex="1">
          <mxGeometry height="520" width="540" x="-10650" y="6603" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-502" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="① 大气温度（辐射强迫）" vertex="1">
          <mxGeometry height="28" width="500" x="-10631.5" y="6658" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-503" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：由太阳黄经和日地距离决定的理论辐射量，叠加大气温室效应" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="6690" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-504" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：辐射传输模型（日射量 = 太阳常数 × 日地距离修正 × cos(天顶角)）" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="6713" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-505" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=8;" value="在五运六气中的角色：热在气化中为君火/相火——温度偏高对应火气偏胜，偏低对应寒水偏胜" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="6736" as="geometry" />
        </mxCell>
