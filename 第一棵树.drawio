        <mxCell id="7L3AGora1TePQE9lAWJE-890" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳是圆盘而非光点，我们看到的是上边缘冒头而非中心，使日出提前约1~2分钟。" vertex="1">
          <mxGeometry height="25" width="180" x="-405840" y="-229840" as="geometry" />
