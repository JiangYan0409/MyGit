          <mxGeometry height="30" width="180" x="-404580" y="-229870" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-938" edge="1" parent="1" source="7L3AGora1TePQE9lAWJE-939" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="7L3AGora1TePQE9lAWJE-943" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-939" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;" value="&lt;span style=&quot;color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font&gt;格里高利历的闰年规则（4年一闰，百年不闰，四百年再闰）决定日期转天数的精度。&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="26" width="180" x="-404580" y="-229839" as="geometry" />
        </mxCell>
