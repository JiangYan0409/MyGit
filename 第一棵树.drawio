          <mxGeometry height="28" width="800" x="-405330.5" y="-223100" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1318" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：十二时辰（子丑寅卯辰巳午未申酉戌亥）对应十二经脉" vertex="1">
