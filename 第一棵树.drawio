        <mxCell id="a6BHbfn1qw_weTyk3Nwu-252" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" value="光行差（周年视差偏移）" vertex="1">
          <mxGeometry height="30" width="180" x="-9360" y="230" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-253" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="地球以30km/s绕日运动，使太阳视位置偏移约20角秒，影响高精度方位角测量。" vertex="1">
