          <mxGeometry height="30" width="180" x="-404580" y="-229803" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-941" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="人为定义的参考历元（2000年1月1日12:00 UTC），所有天文常数以此为基准。" vertex="1">
          <mxGeometry height="26" width="180" x="-404580" y="-229772" as="geometry" />
