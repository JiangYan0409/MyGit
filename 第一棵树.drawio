        <mxCell id="7L3AGora1TePQE9lAWJE-891" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;fontFamily=Microsoft YaHei;" value="太阳引力场（广义相对论）" vertex="1">
          <mxGeometry height="30" width="180" x="-405840" y="-229794" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-892" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳引力使光线弯曲（夏皮罗延迟），影响太阳边缘的观测位置（科研级精度才计入）" vertex="1">
          <mxGeometry height="25" width="180" x="-405840" y="-229763" as="geometry" />
