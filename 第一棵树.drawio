          <mxGeometry height="28" width="800" x="-405330.5" y="-222982" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-1322" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：怒 → 木/肝，喜 → 火/心，思 → 土/脾，悲 → 金/肺，恐 → 水/肾" vertex="1">
          <mxGeometry height="20" width="800" x="-405330.5" y="-222950" as="geometry" />
        </mxCell>
