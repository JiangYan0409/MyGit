        <mxCell id="7L3AGora1TePQE9lAWJE-900" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="极地半径比赤道短约21km，高精度计算时需用WGS-84椭球模型修正观测者到地心的真实距离。" vertex="1">
          <mxGeometry height="40" width="180" x="-405630" y="-229624" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-901" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点纬度（φ）" vertex="1">
          <mxGeometry height="30" width="180" x="-405630" y="-229568" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-902" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="决定地平线与天赤道的夹角，是时角计算的核心输入之一。" vertex="1">
          <mxGeometry height="25" width="180" x="-405630" y="-229537" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-903" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点经度（λ₀）" vertex="1">
          <mxGeometry height="30" width="180" x="-405630" y="-229501" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-904" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="将地方时转换为标准区时的固定偏移。" vertex="1">
          <mxGeometry height="22" width="180" x="-405630" y="-229470" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-905" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点海拔（h）" vertex="1">
          <mxGeometry height="30" width="180" x="-405630" y="-229434" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-906" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="海拔越高，地平线俯角越大，日出越早。" vertex="1">
          <mxGeometry height="22" width="180" x="-405630" y="-229403" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-907" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="局部地形遮挡" vertex="1">
          <mxGeometry height="30" width="180" x="-405630" y="-229367" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-908" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="东面有山/楼会延迟实际看到的日出，不参与天文公式，但影响真实观测。" vertex="1">
          <mxGeometry height="25" width="180" x="-405630" y="-229336" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-909" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球自转不均匀（ΔT）" vertex="1">
          <mxGeometry height="30" width="180" x="-405630" y="-229300" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-910" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="由潮汐摩擦、地核运动等导致，使地球自转速度在世纪尺度上缓慢变化。" vertex="1">
          <mxGeometry height="25" width="180" x="-405630" y="-229269" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-911" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="极移（钱德勒摆动）" vertex="1">
          <mxGeometry height="30" width="180" x="-405630" y="-229233" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-912" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="自转轴相对于地壳微小移动（约±0.3角秒），改变观测点的真实经纬度。" vertex="1">
          <mxGeometry height="25" width="180" x="-405630" y="-229201" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-913" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="稳定地轴倾角（23.44°）" vertex="1">
          <mxGeometry height="30" width="180" x="-405420" y="-229870" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-914" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="使黄赤交角稳定在23.44°附近（波动±1°），保证赤纬长期可用。" vertex="1">
          <mxGeometry height="25" width="180" x="-405420" y="-229839" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-915" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="潮汐摩擦（地球自转变慢）" vertex="1">
          <mxGeometry height="30" width="180" x="-405420" y="-229803" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-916" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="月球引力拽拉海洋和固体地球，使地球自转每世纪减慢约1.8毫秒，累积为ΔT。" vertex="1">
          <mxGeometry height="25" width="180" x="-405420" y="-229772" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-917" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="章动（18.6年周期）" vertex="1">
          <mxGeometry height="30" width="180" x="-405420" y="-229736" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-918" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="使黄赤交角有约±9角秒的周期性摆动，影响赤纬的瞬时精密值。" vertex="1">
          <mxGeometry height="25" width="180" x="-405420" y="-229705" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-919" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="岁差（与太阳合力）" vertex="1">
          <mxGeometry height="30" width="180" x="-405420" y="-229669" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-920" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="月球和太阳共同拖拽赤道隆起带，导致春分点西移（约50角秒/年），改变黄经的零度基准。" vertex="1">
          <mxGeometry height="34" width="180" x="-405420" y="-229637" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-921" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="木星引力摄动" vertex="1">
          <mxGeometry height="30" width="180" x="-405210" y="-229870" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-922" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="木星质量巨大，使地球轨道偏心率在0.003~0.06之间缓慢波动（周期约10万年），改变椭圆修正项的大小。" vertex="1">
          <mxGeometry height="45" width="180" x="-405210" y="-229840" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-923" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="金星引力摄动" vertex="1">
          <mxGeometry height="30" width="180" x="-405210" y="-229783" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-924" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="金星对地球轨道的摄动力仅次于木星，影响黄经长期积分中的近日点辐角变化。" vertex="1">
          <mxGeometry height="22" width="180" x="-405210" y="-229752" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-925" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="其他行星摄动（火土水）" vertex="1">
          <mxGeometry height="30" width="180" x="-405210" y="-229716" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-926" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="贡献较小，但在百万年尺度轨道积分中需累加计入。" vertex="1">
          <mxGeometry height="22" width="180" x="-405210" y="-229684" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-927" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气折射（蒙气差）" vertex="1">
          <mxGeometry height="30" width="180" x="-405000" y="-229870" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-928" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="大气层使光线弯曲，将太阳的视位置“抬高”，让日出提前约2~4分钟。" vertex="1">
          <mxGeometry height="25" width="180" x="-405000" y="-229839" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-929" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气温度与气压" vertex="1">
          <mxGeometry height="30" width="180" x="-405000" y="-229803" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-930" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="折射率随气温和气压变化，影响蒙气差的精密值（亚秒级）。" vertex="1">
          <mxGeometry height="25" width="180" x="-405000" y="-229772" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-931" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气透明度（云/雾霾）" vertex="1">
          <mxGeometry height="30" width="180" x="-405000" y="-229736" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-932" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="不影响太阳几何位置，只决定是否能肉眼看到。" vertex="1">
          <mxGeometry height="25" width="180" x="-405000" y="-229705" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-933" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" value="光行差（周年视差偏移）" vertex="1">
          <mxGeometry height="30" width="180" x="-404790" y="-229870" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-934" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="地球以30km/s绕日运动，使太阳视位置偏移约20角秒，影响高精度方位角测量。" vertex="1">
          <mxGeometry height="25" width="180" x="-404790" y="-229839" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-935" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" value="引力光线弯曲（夏皮罗延迟）" vertex="1">
