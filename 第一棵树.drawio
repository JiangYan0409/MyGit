        <mxCell id="a6BHbfn1qw_weTyk3Nwu-208" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;fontFamily=Microsoft YaHei;" value="太阳视半径（约0.27°）" vertex="1">
          <mxGeometry height="30" width="180" x="-10410" y="230" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-209" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳是圆盘而非光点，我们看到的是上边缘冒头而非中心，使日出提前约1~2分钟。" vertex="1">
          <mxGeometry height="25" width="180" x="-10410" y="260" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-210" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;fontFamily=Microsoft YaHei;" value="太阳引力场（广义相对论）" vertex="1">
          <mxGeometry height="30" width="180" x="-10410" y="306" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-211" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳引力使光线弯曲（夏皮罗延迟），影响太阳边缘的观测位置（科研级精度才计入）" vertex="1">
          <mxGeometry height="25" width="180" x="-10410" y="337" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-212" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="自转速率（15°/h）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="230" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-213" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="角度转换为时间的唯一系数，由恒星日长度（23h56m4s）决定。" vertex="1">
          <mxGeometry height="25" width="180" x="-10200" y="261" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-214" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="黄赤交角（23.44°）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="297" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-215" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="设定太阳直射点的南北移动范围（±23.44°），是四季和赤纬变化的根本源头。" vertex="1">
          <mxGeometry height="38" width="180" x="-10200" y="327.5" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-216" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球半径（6371 km）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="378" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-217" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="作为几何基准，用于计算海拔引起的“地平线俯角”。" vertex="1">
          <mxGeometry height="25" width="180" x="-10200" y="409" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-218" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球椭球体形状（扁率）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="445" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-219" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="极地半径比赤道短约21km，高精度计算时需用WGS-84椭球模型修正观测者到地心的真实距离。" vertex="1">
          <mxGeometry height="40" width="180" x="-10200" y="476" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-220" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点纬度（φ）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="532" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-221" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="决定地平线与天赤道的夹角，是时角计算的核心输入之一。" vertex="1">
          <mxGeometry height="25" width="180" x="-10200" y="563" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-222" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点经度（λ₀）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="599" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-223" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="将地方时转换为标准区时的固定偏移。" vertex="1">
          <mxGeometry height="22" width="180" x="-10200" y="630" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-224" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点海拔（h）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="666" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-225" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="海拔越高，地平线俯角越大，日出越早。" vertex="1">
          <mxGeometry height="22" width="180" x="-10200" y="697" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-226" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="局部地形遮挡" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="733" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-227" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="东面有山/楼会延迟实际看到的日出，不参与天文公式，但影响真实观测。" vertex="1">
          <mxGeometry height="25" width="180" x="-10200" y="764" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-228" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球自转不均匀（ΔT）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="800" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-229" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="由潮汐摩擦、地核运动等导致，使地球自转速度在世纪尺度上缓慢变化。" vertex="1">
          <mxGeometry height="25" width="180" x="-10200" y="831" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-230" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="极移（钱德勒摆动）" vertex="1">
          <mxGeometry height="30" width="180" x="-10200" y="867" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-231" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="自转轴相对于地壳微小移动（约±0.3角秒），改变观测点的真实经纬度。" vertex="1">
          <mxGeometry height="25" width="180" x="-10200" y="899" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-232" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="稳定地轴倾角（23.44°）" vertex="1">
          <mxGeometry height="30" width="180" x="-9990" y="230" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-233" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="使黄赤交角稳定在23.44°附近（波动±1°），保证赤纬长期可用。" vertex="1">
          <mxGeometry height="25" width="180" x="-9990" y="261" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-234" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="潮汐摩擦（地球自转变慢）" vertex="1">
          <mxGeometry height="30" width="180" x="-9990" y="297" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-235" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="月球引力拽拉海洋和固体地球，使地球自转每世纪减慢约1.8毫秒，累积为ΔT。" vertex="1">
          <mxGeometry height="25" width="180" x="-9990" y="328" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-236" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="章动（18.6年周期）" vertex="1">
          <mxGeometry height="30" width="180" x="-9990" y="364" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-237" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="使黄赤交角有约±9角秒的周期性摆动，影响赤纬的瞬时精密值。" vertex="1">
          <mxGeometry height="25" width="180" x="-9990" y="395" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-238" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="岁差（与太阳合力）" vertex="1">
          <mxGeometry height="30" width="180" x="-9990" y="431" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-239" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="月球和太阳共同拖拽赤道隆起带，导致春分点西移（约50角秒/年），改变黄经的零度基准。" vertex="1">
          <mxGeometry height="34" width="180" x="-9990" y="463" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-240" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="木星引力摄动" vertex="1">
          <mxGeometry height="30" width="180" x="-9780" y="230" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-241" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="木星质量巨大，使地球轨道偏心率在0.003~0.06之间缓慢波动（周期约10万年），改变椭圆修正项的大小。" vertex="1">
          <mxGeometry height="45" width="180" x="-9780" y="260" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-242" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="金星引力摄动" vertex="1">
          <mxGeometry height="30" width="180" x="-9780" y="317" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-243" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="金星对地球轨道的摄动力仅次于木星，影响黄经长期积分中的近日点辐角变化。" vertex="1">
          <mxGeometry height="22" width="180" x="-9780" y="348" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-244" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="其他行星摄动（火土水）" vertex="1">
          <mxGeometry height="30" width="180" x="-9780" y="384" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-245" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="贡献较小，但在百万年尺度轨道积分中需累加计入。" vertex="1">
          <mxGeometry height="22" width="180" x="-9780" y="416" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-246" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气折射（蒙气差）" vertex="1">
          <mxGeometry height="30" width="180" x="-9570" y="230" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-247" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="大气层使光线弯曲，将太阳的视位置“抬高”，让日出提前约2~4分钟。" vertex="1">
          <mxGeometry height="25" width="180" x="-9570" y="261" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-248" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气温度与气压" vertex="1">
          <mxGeometry height="30" width="180" x="-9570" y="297" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-249" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="折射率随气温和气压变化，影响蒙气差的精密值（亚秒级）。" vertex="1">
          <mxGeometry height="25" width="180" x="-9570" y="328" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-250" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气透明度（云/雾霾）" vertex="1">
          <mxGeometry height="30" width="180" x="-9570" y="364" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-251" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="不影响太阳几何位置，只决定是否能肉眼看到。" vertex="1">
