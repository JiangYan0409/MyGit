          <mxGeometry height="28" width="500" x="-10631.5" y="6776" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-507" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：由海洋蒸发、风带输送、降水决定，单位g/kg或相对湿度%" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="6808" as="geometry" />
        </mxCell>
