        <mxCell id="a6BHbfn1qw_weTyk3Nwu-536" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;fontFamily=Microsoft YaHei;opacity=60;arcSize=4;verticalAlign=top;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;对生命的影响&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="570" width="900" x="-9130" y="6531" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-537" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;fontFamily=Microsoft YaHei;arcSize=3;" value="人体响应（五运六气作用下，人体反应）" vertex="1">
          <mxGeometry height="523" width="860" x="-9110" y="6568" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-538" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="① 五脏应时（脏气法时）" vertex="1">
          <mxGeometry height="28" width="800" x="-9080.5" y="6623" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-539" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：肝 → 春/木，心 → 夏/火，脾 → 长夏/土，肺 → 秋/金，肾 → 冬/水" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6655" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-540" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：五运（木火土金水）→ 五脏（肝心脾肺肾）——运气的五行属性直接对应到相应的脏" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6678" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-541" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：五运的直接响应终端——木运偏胜 → 肝气亢，火运不及 → 心气虚，土运太过 → 脾湿困，金运偏胜 → 肺燥，水运不及 → 肾虚" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6701" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-542" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="② 经络流注（子午流注）" vertex="1">
          <mxGeometry height="28" width="800" x="-9080.5" y="6741" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-543" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：十二时辰（子丑寅卯辰巳午未申酉戌亥）对应十二经脉" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6773" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-544" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：子时→胆经，丑时→肝经，寅时→肺经，卯时→大肠经，辰时→胃经，巳时→脾经，午时→心经，未时→小肠经，申时→膀胱经，酉时→肾经，戌时→心包经，亥时→三焦经" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6796" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-545" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：六气的日周期在人体的投射——六气升降对应气血在经络中的盛衰流注，是针灸“择时取穴”的气化依据" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6819" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-546" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="③ 五志 / 情志响应" vertex="1">
          <mxGeometry height="28" width="800" x="-9080.5" y="6859" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-547" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：怒 → 木/肝，喜 → 火/心，思 → 土/脾，悲 → 金/肺，恐 → 水/肾" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6891" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-548" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：五运偏性 → 相应情志偏胜——木运太过则怒，火运太过则喜/躁，土运太过则思虑过度，金运太过则悲，水运太过则恐" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6914" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-549" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：运气的心理/情绪终端——五运六气作用于人体，首先表现为情志倾向的改变，继而影响行为和社会群体心理" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="6937" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-550" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="④ 疫病易感性（瘟疫 / 寒疫 / 湿温）" vertex="1">
          <mxGeometry height="28" width="800" x="-9080.5" y="6977" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-551" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：特定年份（如太乙天符、天刑年）的特定病种高发概率——历史流行病学经验归纳" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="7009" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-552" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：火运太过 + 少阴君火司天 → 温厉；寒水太过 + 太阳寒水司天 → 寒疫；湿土太过 + 太阴湿土司天 → 湿温/脾胃疫" vertex="1">
          <mxGeometry height="20" width="800" x="-9080.5" y="7032" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-553" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：五运六气的“最显眼输出”——当运气异常叠加时，人体正气无法适应环境变化，特定疫病（流行病）爆发的概率显著升高，是疫病预测的核心依据" vertex="1">
