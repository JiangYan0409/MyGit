        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-894" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="角度转换为时间的唯一系数，由恒星日长度（23h56m4s）决定。" vertex="1">
          <mxGeometry height="25" width="180" x="-405630" y="-229839" as="geometry" />
