        <mxCell id="7L3AGora1TePQE9lAWJE-297" edge="1" parent="1" source="7L3AGora1TePQE9lAWJE-173" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="7L3AGora1TePQE9lAWJE-285">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-299" edge="1" parent="1" source="7L3AGora1TePQE9lAWJE-173" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" target="7L3AGora1TePQE9lAWJE-287">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-181" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;fontFamily=Microsoft YaHei;" value="太阳视半径（约0.27°）" vertex="1">
          <mxGeometry height="30" width="180" x="-30" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-182" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳是圆盘而非光点，我们看到的是上边缘冒头而非中心，使日出提前约1~2分钟。" vertex="1">
          <mxGeometry height="25" width="180" x="-30" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-183" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;fontFamily=Microsoft YaHei;" value="太阳引力场（广义相对论）" vertex="1">
          <mxGeometry height="30" width="180" x="-30" y="1396" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-184" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳引力使光线弯曲（夏皮罗延迟），影响太阳边缘的观测位置（科研级精度才计入）" vertex="1">
          <mxGeometry height="25" width="180" x="-30" y="1427" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-189" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="自转速率（15°/h）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-190" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="角度转换为时间的唯一系数，由恒星日长度（23h56m4s）决定。" vertex="1">
          <mxGeometry height="25" width="180" x="180" y="1351" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-191" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="黄赤交角（23.44°）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1387" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-192" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="设定太阳直射点的南北移动范围（±23.44°），是四季和赤纬变化的根本源头。" vertex="1">
          <mxGeometry height="38" width="180" x="180" y="1417.5" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-193" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球半径（6371 km）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1468" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-194" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="作为几何基准，用于计算海拔引起的“地平线俯角”。" vertex="1">
          <mxGeometry height="25" width="180" x="180" y="1499" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-195" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球椭球体形状（扁率）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1535" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-196" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="极地半径比赤道短约21km，高精度计算时需用WGS-84椭球模型修正观测者到地心的真实距离。" vertex="1">
          <mxGeometry height="40" width="180" x="180" y="1566" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-197" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点纬度（φ）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1622" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-198" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="决定地平线与天赤道的夹角，是时角计算的核心输入之一。" vertex="1">
          <mxGeometry height="25" width="180" x="180" y="1653" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-199" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点经度（λ₀）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1689" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-200" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="将地方时转换为标准区时的固定偏移。" vertex="1">
          <mxGeometry height="22" width="180" x="180" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-201" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="观测点海拔（h）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1756" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-202" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="海拔越高，地平线俯角越大，日出越早。" vertex="1">
          <mxGeometry height="22" width="180" x="180" y="1787" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-203" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="局部地形遮挡" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1823" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-204" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="东面有山/楼会延迟实际看到的日出，不参与天文公式，但影响真实观测。" vertex="1">
          <mxGeometry height="25" width="180" x="180" y="1854" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-205" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="地球自转不均匀（ΔT）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1890" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-206" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="由潮汐摩擦、地核运动等导致，使地球自转速度在世纪尺度上缓慢变化。" vertex="1">
          <mxGeometry height="25" width="180" x="180" y="1921" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-207" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="极移（钱德勒摆动）" vertex="1">
          <mxGeometry height="30" width="180" x="180" y="1957" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-208" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="自转轴相对于地壳微小移动（约±0.3角秒），改变观测点的真实经纬度。" vertex="1">
          <mxGeometry height="25" width="180" x="180" y="1989" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-229" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="稳定地轴倾角（23.44°）" vertex="1">
          <mxGeometry height="30" width="180" x="390" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-230" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="使黄赤交角稳定在23.44°附近（波动±1°），保证赤纬长期可用。" vertex="1">
          <mxGeometry height="25" width="180" x="390" y="1351" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-231" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="潮汐摩擦（地球自转变慢）" vertex="1">
          <mxGeometry height="30" width="180" x="390" y="1387" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-232" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="月球引力拽拉海洋和固体地球，使地球自转每世纪减慢约1.8毫秒，累积为ΔT。" vertex="1">
          <mxGeometry height="25" width="180" x="390" y="1418" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-233" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="章动（18.6年周期）" vertex="1">
          <mxGeometry height="30" width="180" x="390" y="1454" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-234" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="使黄赤交角有约±9角秒的周期性摆动，影响赤纬的瞬时精密值。" vertex="1">
          <mxGeometry height="25" width="180" x="390" y="1485" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-235" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=Microsoft YaHei;" value="岁差（与太阳合力）" vertex="1">
          <mxGeometry height="30" width="180" x="390" y="1521" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-236" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="月球和太阳共同拖拽赤道隆起带，导致春分点西移（约50角秒/年），改变黄经的零度基准。" vertex="1">
          <mxGeometry height="34" width="180" x="390" y="1553" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-245" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="木星引力摄动" vertex="1">
          <mxGeometry height="30" width="180" x="600" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-246" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="木星质量巨大，使地球轨道偏心率在0.003~0.06之间缓慢波动（周期约10万年），改变椭圆修正项的大小。" vertex="1">
          <mxGeometry height="45" width="180" x="600" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-247" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="金星引力摄动" vertex="1">
          <mxGeometry height="30" width="180" x="600" y="1407" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-248" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="金星对地球轨道的摄动力仅次于木星，影响黄经长期积分中的近日点辐角变化。" vertex="1">
          <mxGeometry height="22" width="180" x="600" y="1438" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-249" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Microsoft YaHei;" value="其他行星摄动（火土水）" vertex="1">
          <mxGeometry height="30" width="180" x="600" y="1474" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-250" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="贡献较小，但在百万年尺度轨道积分中需累加计入。" vertex="1">
          <mxGeometry height="22" width="180" x="600" y="1506" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-257" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气折射（蒙气差）" vertex="1">
          <mxGeometry height="30" width="180" x="810" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-258" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="大气层使光线弯曲，将太阳的视位置“抬高”，让日出提前约2~4分钟。" vertex="1">
          <mxGeometry height="25" width="180" x="810" y="1351" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-259" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气温度与气压" vertex="1">
          <mxGeometry height="30" width="180" x="810" y="1387" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-260" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="折射率随气温和气压变化，影响蒙气差的精密值（亚秒级）。" vertex="1">
          <mxGeometry height="25" width="180" x="810" y="1418" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-261" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Microsoft YaHei;" value="大气透明度（云/雾霾）" vertex="1">
          <mxGeometry height="30" width="180" x="810" y="1454" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-262" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="不影响太阳几何位置，只决定是否能肉眼看到。" vertex="1">
          <mxGeometry height="25" width="180" x="810" y="1485" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-269" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" value="光行差（周年视差偏移）" vertex="1">
          <mxGeometry height="30" width="180" x="1020" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-270" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="地球以30km/s绕日运动，使太阳视位置偏移约20角秒，影响高精度方位角测量。" vertex="1">
          <mxGeometry height="25" width="180" x="1020" y="1351" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-271" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Microsoft YaHei;" value="引力光线弯曲（夏皮罗延迟）" vertex="1">
          <mxGeometry height="30" width="180" x="1020" y="1387" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-272" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳引力场使光线弯曲约1.75角秒，影响太阳边缘的精密定位。" vertex="1">
          <mxGeometry height="25" width="180" x="1020" y="1418" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-277" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontFamily=Microsoft YaHei;" value="公历历法规则（闰年）" vertex="1">
          <mxGeometry height="30" width="180" x="1230" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-301" edge="1" parent="1" source="7L3AGora1TePQE9lAWJE-278" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="7L3AGora1TePQE9lAWJE-282" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-278" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;" value="&lt;span style=&quot;color: rgb(15, 17, 21); font-family: quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font&gt;格里高利历的闰年规则（4年一闰，百年不闰，四百年再闰）决定日期转天数的精度。&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="26" width="180" x="1230" y="1351" as="geometry" />
        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-279" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontFamily=Microsoft YaHei;" value="J2000.0 历元" vertex="1">
