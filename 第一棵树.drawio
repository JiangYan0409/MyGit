        <mxCell id="7L3AGora1TePQE9lAWJE-893" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=Microsoft YaHei;" value="自转速率（15°/h）" vertex="1">
