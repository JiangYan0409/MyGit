        </mxCell>
        <mxCell id="7L3AGora1TePQE9lAWJE-936" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;fontFamily=Microsoft YaHei;fontColor=#666666;" value="太阳引力场使光线弯曲约1.75角秒，影响太阳边缘的精密定位。" vertex="1">
          <mxGeometry height="25" width="180" x="-404790" y="-229772" as="geometry" />
        </mxCell>
