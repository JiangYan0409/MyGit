          <mxGeometry height="20" width="500" x="-10631.5" y="6831" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-509" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=8;" value="在五运六气中的角色：湿为太阴湿土——湿气偏重对应土运/湿土之气偏胜，是长夏和梅雨的主导因素" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="6854" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-510" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="③ 大气压强（风带/气旋系统）" vertex="1">
          <mxGeometry height="28" width="500" x="-10631.5" y="6894" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-511" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：海平面气压（hPa），高空位势高度（gpm），副高/气旋/反气旋强度" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="6926" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-512" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：气压梯度力 + 科里奥利力 → 地转风；温度梯度驱动经向环流" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="6949" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-513" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=8;" value="在五运六气中的角色：风为厥阴风木——风带和气压系统的移动，是六气中气变化的直接动力来源" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="6972" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-514" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="④ 海洋温度 / 洋流（热容与输送）" vertex="1">
          <mxGeometry height="28" width="500" x="-10631.5" y="7012" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-515" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：海表温度（SST），厄尔尼诺/拉尼娜指数（ONI），洋流输送量" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="7044" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-516" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：海气耦合模型——海洋热含量变化滞后于大气强迫约1~3个月" vertex="1">
          <mxGeometry height="20" width="500" x="-10631.5" y="7067" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-517" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#003366;align=left;spacingLeft=8;" value="在五运六气中的角色：调制客气中的寒热偏差——海洋异常（如厄尔尼诺）是客气年度异常的大尺度物理实现，对应六气的“太过/不及”" vertex="1">
          <mxGeometry height="26" width="500" x="-10631.5" y="7090" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-518" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;fontFamily=Microsoft YaHei;arcSize=3;verticalAlign=top;" value="局部修正（大运 → 小气候）" vertex="1">
          <mxGeometry height="520" width="511.5" x="-10071.5" y="6603" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-519" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑤ 观测点纬度" vertex="1">
          <mxGeometry height="28" width="480" x="-10055.5" y="6652" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-520" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：北纬/南纬 0°~90°，决定太阳高度角、昼夜时长、季节相位" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6684" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-521" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：纬度越高 → 太阳高度角越低 → 辐射通量越分散 → 气温年较差越大" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6707" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-522" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：同一运气格局，赤道/温带/寒带表现完全不同——纬度决定气化的“基础温度+季节相位”" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6730" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-523" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑥ 观测点经度 / 时区" vertex="1">
          <mxGeometry height="28" width="480" x="-10055.5" y="6770" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-524" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：东经/西经 0°~180°，决定与UTC的固定偏移" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6802" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-525" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：每15°经度对应1小时时差，影响“当地正午”与“理论节气时刻”的相位差" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6825" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-526" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：同一时令，各地气化不同——经度决定“朔气时刻”与“本地时辰”的对齐或错位" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6848" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-527" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑦ 海拔高度" vertex="1">
          <mxGeometry height="28" width="480" x="-10055.5" y="6888" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-528" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：海平面以上高度（m），每升高1000m温度平均下降约6.5°C（干绝热/湿绝热递减率）" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6920" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-529" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：气压、温度、湿度随高度呈指数/线性变化；大气垂直分层（对流层/平流层）" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6943" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-530" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：海拔越高 → 气温越低、气压越低 → 寒象偏重，“高寒”或“低暖”的修正叠加在五运六气之上" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="6966" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-531" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=12;fontStyle=1;fontFamily=Microsoft YaHei;" value="⑧ 局部地形（山脉 / 盆地 / 水域）" vertex="1">
          <mxGeometry height="28" width="480" x="-10055.5" y="7006" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-532" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="具体参数：地形分类（山地/平原/盆地/沿海/内陆），风带走廊或阻挡效应" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="7038" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-533" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#333333;align=left;spacingLeft=8;" value="映射规则：地形抬升 → 降水增加；盆地 → 热岛/逆温；沿海 → 海洋性气候（温差小、湿度大）" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="7061" as="geometry" />
        </mxCell>
        <mxCell id="a6BHbfn1qw_weTyk3Nwu-534" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=10;fontFamily=Microsoft YaHei;fontColor=#336600;align=left;spacingLeft=8;" value="在五运六气中的角色：形成“同气异化”——同一六气在不同地形下表现不同（如盆地暑湿更重，山地风多寒盛）" vertex="1">
          <mxGeometry height="20" width="480" x="-10055.5" y="7084" as="geometry" />
        </mxCell>
